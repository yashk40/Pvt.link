NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:8081,http://localhost:3000
# Desktop-agent token secret only; user auth is delegated to Firebase.
JWT_AGENT_SECRET=use-a-third-long-random-secret
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
IMGHOSTING_API_KEY=your-imghosting-api-key
